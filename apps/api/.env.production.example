# ============================================================
# Tan Thuan Port API - Production Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.production.example .env
#
# NEVER commit .env to version control!
# ============================================================

# ---- Database ----
# Preferred: internal PostgreSQL managed by the company
DATABASE_URL=postgresql://tanthuan_app:<strong-password>@postgres.internal.company:5432/tanthuan

# Optional override when using Docker Compose or runtime-injected vars
# POSTGRES_DB=tanthuan
# POSTGRES_USER=tanthuan_app
# POSTGRES_PASSWORD=<strong-random-password>
# POSTGRES_PORT=5432

# ---- JWT Authentication ----
# Generate with: openssl rand -base64 64
# Must be at least 32 characters
JWT_SECRET=<generate-with-openssl-rand-base64-64>
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=3001
NODE_ENV=production

# ---- CORS ----
# Internal frontend domain exposed through reverse proxy (no trailing slash)
CORS_ORIGIN=https://tanthuan.internal

# ---- Sentry (Error Tracking) ----
# Optional. Leave empty if company logging/monitoring is used instead.
SENTRY_DSN=
